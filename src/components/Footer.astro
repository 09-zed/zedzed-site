---
import { site } from '../data/site';
---
<div class="ft-wrap">
<footer class="ft grid-bg grid-dark" id="reserver">
  <div class="wrap">
    <div class="ft-top">
      <nav class="ft-col" aria-label="Pages"><h3>Pages</h3><a href="/#travaux">Projets</a><a href="/#studio">Studio</a><a href="/#methode">Méthode</a><a href="/#contact">Contact</a></nav>
      <div class="ft-col"><h3>Contact</h3><a href={`mailto:${site.email}`}>{site.email}</a><p>{site.ville} · Grand&nbsp;Est</p><p class="soft"><span class="clock">--:--</span> à {site.ville}</p></div>
      <div class="book" aria-labelledby="book-t">
        <div class="book-head"><div><h3 id="book-t">Appel découverte</h3><p>20&nbsp;min · en visio · sans engagement</p></div><span class="book-mark" aria-hidden="true">z</span></div>
        <div class="book-cal" id="cal-zedzed" data-cal={site.cal}>
          <a class="book-go" href={`https://cal.com/${site.cal}`} target="_blank" rel="noopener">Voir les créneaux</a>
        </div>
      </div>
    </div>
    <div class="ft-legal"><span>© {new Date().getFullYear()} zedzed · Studio de design et de développement web</span><span><a href="/mentions-legales">Mentions légales</a>{site.linkedin && <> · <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></>}</span></div>
  </div>
  <div class="ft-logo" aria-hidden="true"><span>zed<i>zed</i></span></div>
</footer>
</div>
