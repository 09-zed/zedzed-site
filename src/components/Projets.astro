---
import { getCollection } from 'astro:content';
// accueil : section de la page d'accueil (projets marqués accueil: true + lien vers /realisations/).
// Sans accueil : page /realisations/, tous les projets, titre en h1.
const { accueil = false } = Astro.props;
const tous = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
const projets = accueil ? tous.filter(p => p.data.accueil) : tous;
const Titre = accueil ? 'h2' : 'h1';
---
<section class:list={["section grid-bg", { "page-real": !accueil }]} id="travaux" data-reveal>
    <div class="wrap">
      <div class="sec-head">
        <Titre><span class="mask"><span>{accueil ? 'Projets' : 'Réalisations'}</span></span></Titre>
        <p data-up>Des sites et des outils pour des entreprises de tous métiers, chacun dessiné pour le sien.</p>
      </div>
      <div class="projects" data-reveal>
        {projets.map((p, i) => {
          const Tag = p.data.lien ? 'a' : 'div';
          return (
            <Tag class="project" href={p.data.lien} target={p.data.lien ? '_blank' : undefined} rel={p.data.lien ? 'noopener' : undefined} data-cursor={p.data.lien ? 'Voir' : undefined} data-up style={`--i:${i}`}>
              <div class="pcard">
                <div class="pmeta"><h3>{p.data.nom}</h3><span class="tag"><em>{p.data.concept ? 'Concept' : 'Secteur'}</em>{p.data.secteur}</span></div>
                <div class="compare">
                  <img class="shot" src={p.data.image.replace('.webp', '-1000.webp')} srcset={[640, 1000, 1400].map(w => `${p.data.image.replace('.webp', `-${w}.webp`)} ${w}w`).join(', ')} sizes="(max-width: 820px) calc(100vw - 40px), 46vw" alt={p.data.alt} width={p.data.largeur} height={p.data.hauteur} loading="lazy" decoding="async" />
                </div>
              </div>
            </Tag>
          );
        })}
      </div>
      {accueil && tous.length > projets.length && (
        <div class="projects-more" data-up><a class="btn on-light" href="/realisations/"><span class="t"><span>Voir toutes les réalisations</span><span aria-hidden="true">Voir toutes les réalisations</span></span></a></div>
      )}
    </div>
  </section>
